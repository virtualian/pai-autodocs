---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>

<footer class="pai-footer">
	<p>
		<a href="https://github.com/danielmiessler/Personal_AI_Infrastructure" class="pai-version-badge">PAI v3.0</a>
		&nbsp;
		<a href="https://github.com/danielmiessler/Personal_AI_Infrastructure">PAI</a> is created by
		<strong><a href="https://github.com/danielmiessler">Daniel Miessler</a></strong>.
		Docs generated by <a href="https://claude.ai">Claude</a> |
		Structured with <a href="https://diataxis.fr/">Diataxis</a> |
		<a href="https://github.com/virtualian/pai-autodocs">Repository</a> created by <a href="https://github.com/virtualian">@virtualian</a>
	</p>
	<p class="pai-footer-versions">
		Algorithm v1.5.0 &middot; Site v1.0.0 |
		<a href="/changelog/">Changelog</a>
	</p>
</footer>

<style>
	.pai-footer {
		text-align: center;
		padding: 1rem 1.5rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
		border-top: 1px solid var(--sl-color-gray-5);
	}
	.pai-footer a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.pai-footer a:hover {
		text-decoration: underline;
	}
	.pai-footer strong a {
		color: var(--sl-color-white);
	}
	.pai-footer-versions {
		margin-top: 0.25rem;
		font-size: 0.75rem;
		color: var(--sl-color-gray-4);
	}
</style>
